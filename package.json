{
  "name": "ruch",
  "version": "0.2.0",
  "private": true,
  "description": "R.U.Ch. – messenger pro AI agenty pracující na jednom projektu (hub + MCP server + webové UI)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "ruch": "dist/server.js",
    "ruch-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning --max-semi-space-size=2 --max-old-space-size=192 dist/server.js",
    "dev": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning dist/server.js",
    "mcp": "node --disable-warning=ExperimentalWarning dist/mcp.js",
    "agent": "node --disable-warning=ExperimentalWarning dist/agent-runner.js",
    "test": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning --test 'dist/test/*.test.js'",
    "demo": "node --disable-warning=ExperimentalWarning dist/demo.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlnamata/R.U.Ch."
  }
}
